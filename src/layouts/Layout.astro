      h2 { font-size: clamp(2rem, 4.5vw, 2.8rem); font-weight: 500; }
      h3 { font-size: clamp(1.2rem, 2.5vw, 1.45rem); font-weight: 700; }

      p { color: var(--texto-2); }

      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }

      .container {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 clamp(1.5rem, 6vw, 3rem);
      }

      .section { padding: var(--gap) 0; }
      .section--alt { background: var(--lavanda-1); }

      .section--dark {
        background: var(--lilas-2);
        color: var(--branco);
      }

      .section--dark h2,
      .section--dark h3 { color: var(--branco); }
      .section--dark p   { color: rgba(255,255,255,0.95); }

      .label {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--lilas);
        display: block;
        margin-bottom: 0.85rem;
