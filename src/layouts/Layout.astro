        font-size: clamp(0.82rem, 2.5vw, 1.1rem);
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--branco);
        background: var(--lilas-2);
        display: inline-block;
        padding: 0.45rem 1.1rem;
        border-radius: 2rem;
        margin-bottom: 1.25rem;
        white-space: nowrap;
      }

      .section--dark .label { color: var(--lavanda-2); }

      .divider {
        width: 3.5rem;
        height: 3px;
        background: var(--lavanda-3);
        border-radius: 3px;
        margin: 1.5rem 0;
      }

      .section--dark .divider { background: rgba(255,255,255,0.5); }

      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
