---
const {
  title = 'Em Casa Vet — Atendimento Veterinário Domiciliar',
  description = 'Atendimento veterinário domiciliar em Londrina, Cambé e Ibiporã. Consultas, vacinas, geriatria e cuidados paliativos — no aconchego do lar.',
} = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "VeterinaryCare",
      "@id": "https://emcasa.vet",
      "name": "Em Casa Vet",
      "description": "Atendimento veterinário domiciliar especializado em geriatria e cuidados paliativos para animais em Londrina, Cambé e Ibiporã.",
      "url": "https://emcasa.vet",
      "telephone": "+5543988577434",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Londrina",
        "addressRegion": "PR",
        "addressCountry": "BR"
      },
      "areaServed": [
        { "@type": "City", "name": "Londrina" },
        { "@type": "City", "name": "Cambé" },
        { "@type": "City", "name": "Ibiporã" }
      ],
      "provider": {
        "@type": "Person",
        "@id": "https://vanessaokamura.com.br",
        "name": "Vanessa Yoshida Okamura",
        "identifier": "CRMV-PR 16455"
      },
      "sameAs": "https://vanessaokamura.com.br",
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": "Serviços veterinários domiciliares",
        "itemListElement": [
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Consulta clínica domiciliar" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Vacinas" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Coleta de exames de sangue" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Soro em domicílio" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Acompanhamento pré e pós-cirúrgico" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Geriatria veterinária" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Cuidados paliativos" } },
          { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Encaminhamento e acompanhamento" } }
        ]
      }
    },
    {
      "@type": "Person",
      "@id": "https://vanessaokamura.com.br",
      "name": "Vanessa Yoshida Okamura",
      "url": "https://vanessaokamura.com.br",
      "image": "https://emcasa.vet/imagens/vanessa-real.webp",
      "jobTitle": "Médica Veterinária",
      "hasCredential": [
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Mestrado em Clínicas Veterinárias",
          "educationalLevel": "Mestrado Profissional",
          "recognizedBy": { "@type": "Organization", "name": "UEL — Universidade Estadual de Londrina" }
        },
        {
          "@type": "EducationalOccupationalCredential",
          "name": "Especialização em Cuidados Paliativos e Terapia da Dor",
          "educationalLevel": "Pós-graduação",
          "recognizedBy": { "@type": "Organization", "name": "PUC Minas" }
        }
      ],
      "knowsAbout": [
        "Geriatria veterinária",
        "Cuidados paliativos animais",
        "Medicina veterinária baseada em evidências",
        "Atendimento domiciliar veterinário"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://emcasa.vet/#website",
      "url": "https://emcasa.vet",
      "name": "Em Casa Vet",
      "description": "Atendimento veterinário domiciliar em Londrina, Cambé e Ibiporã.",
      "inLanguage": "pt-BR",
      "publisher": { "@id": "https://vanessaokamura.com.br" }
    }
  ]
};
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={`https://emcasa.vet${Astro.url.pathname}`} />
    <style>
  @font-face {
    font-display: swap;
    font-family: 'Playfair Display';
    font-style: normal;
    font-weight: 400;
    src: url('/fonts/playfair-display-v40-latin-regular.woff2') format('woff2');
  }
  @font-face {
    font-display: swap;
    font-family: 'Playfair Display';
    font-style: normal;
    font-weight: 600;
    src: url('/fonts/playfair-display-v40-latin-600.woff2') format('woff2');
  }
  @font-face {
    font-display: swap;
    font-family: 'Playfair Display';
    font-style: italic;
    font-weight: 600;
    src: url('/fonts/playfair-display-v40-latin-600italic.woff2') format('woff2');
  }
  @font-face {
    font-display: swap;
    font-family: 'Nunito';
    font-style: normal;
    font-weight: 400;
    src: url('/fonts/nunito-v32-latin-regular.woff2') format('woff2');
  }
  @font-face {
    font-display: swap;
    font-family: 'Nunito';
    font-style: normal;
    font-weight: 700;
    src: url('/fonts/nunito-v32-latin-700.woff2') format('woff2');
  }
</style>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "VeterinaryCare",
          "@id": "https://emcasa.vet",
          "name": "Em Casa Vet",
          "description": "Atendimento veterinário domiciliar especializado em geriatria e cuidados paliativos para animais em Londrina, Cambé e Ibiporã.",
          "url": "https://emcasa.vet",
          "telephone": "+5543988577434",
          "address": {
            "@type": "PostalAddress",
            "addressLocality": "Londrina",
            "addressRegion": "PR",
            "addressCountry": "BR"
          },
          "areaServed": [
            { "@type": "City", "name": "Londrina" },
            { "@type": "City", "name": "Cambé" },
            { "@type": "City", "name": "Ibiporã" }
          ],
          "provider": {
            "@type": "Person",
            "@id": "https://vanessaokamura.com.br",
            "name": "Vanessa Yoshida Okamura",
            "identifier": "CRMV-PR 16455"
          },
          "sameAs": "https://vanessaokamura.com.br"
        },
        {
          "@type": "Person",
          "@id": "https://vanessaokamura.com.br",
          "name": "Vanessa Yoshida Okamura",
          "url": "https://vanessaokamura.com.br",
          "image": "https://emcasa.vet/imagens/vanessa-real.webp",
          "jobTitle": "Médica Veterinária"
        }
      ]
    }
    </script>
    <style is:inline>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --branco:     #ffffff;
        --base:       #fdfcff;
        --lavanda-1:  #f0ebfa;
        --lavanda-2:  #e2d8f5;
        --lavanda-3:  #c8b8e8;
        --lilas:      #7a5fb0;
        --lilas-2:    #6b4fa0;
        --rosa:       #f5eef8;
        --texto:      #1a1523;
        --texto-2:    #3d3352;
        --suave:      #5a4e6a;

        --font-display: 'Playfair Display', Georgia, serif;
        --font-body:    'Nunito', sans-serif;

        --max-w: 860px;
        --gap:   clamp(4rem, 10vw, 8rem);
        --r:     1.25rem;
      }

      html { scroll-behavior: smooth; }

      body {
        background: var(--branco);
        color: var(--texto);
        font-family: var(--font-body);
        font-size: clamp(18px, 2.2vw, 20px);
        font-weight: 400;
        line-height: 1.85;
        -webkit-font-smoothing: antialiased;
        overflow-x: hidden;
      }

      h1, h2, h3 {
        font-family: var(--font-display);
        line-height: 1.2;
        color: var(--texto);
      }

      h1 { font-size: clamp(2.8rem, 7.5vw, 5rem); font-weight: 600; }
      h2 { font-size: clamp(2rem, 4.5vw, 2.8rem); font-weight: 500; }
      h3 { font-size: clamp(1.2rem, 2.5vw, 1.45rem); font-weight: 700; }

      p { color: var(--texto-2); }

      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }

      .container {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 clamp(1.5rem, 6vw, 3rem);
      }

      .section { padding: var(--gap) 0; }
      .section--alt { background: var(--lavanda-1); }

      .section--dark {
        background: var(--lilas-2);
        color: var(--branco);
      }

      .section--dark h2,
      .section--dark h3 { color: var(--branco); }
      .section--dark p   { color: rgba(255,255,255,0.95); }

      .label {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--lilas);
        display: block;
        margin-bottom: 0.85rem;
      }

      .label--hero {
        font-size: clamp(0.82rem, 2.5vw, 1.1rem);
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--branco);
        background: var(--lilas-2);
        display: inline-block;
        padding: 0.45rem 1.1rem;
        border-radius: 2rem;
        margin-bottom: 1.25rem;
        white-space: nowrap;
      }

      .section--dark .label { color: var(--lavanda-2); }

      .divider {
        width: 3.5rem;
        height: 3px;
        background: var(--lavanda-3);
        border-radius: 3px;
        margin: 1.5rem 0;
      }

      .section--dark .divider { background: rgba(255,255,255,0.5); }

      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .fade-up   { animation: fadeUp 0.9s ease both; }
      .fade-up-2 { animation-delay: 0.15s; }
      .fade-up-3 { animation-delay: 0.3s; }
      .fade-up-4 { animation-delay: 0.45s; }
    </style>
  </head>
  <body>
    <main>
      <slot />
    </main>
  </body>
</html>
