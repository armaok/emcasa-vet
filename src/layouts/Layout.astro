---
export interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Em Casa Vet — Atendimento Veterinário Domiciliar',
  description = 'Atendimento veterinário domiciliar em Londrina, Cambé e Ibiporã. Consultas, vacinas, geriatria e cuidados paliativos — no aconchego do lar.',
} = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&family=Nunito:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --base:       #faf8fc;
        --base-2:     #f2eef8;
        --lavanda:    #c9b8e8;
        --lilas:      #9b7fd4;
        --roxo:       #6b4fa0;
        --roxo-2:     #4e3378;
        --rosado:     #f0e6f6;
        --texto:      #1e1428;
        --texto-2:    #3d2e58;
        --suave:      #7a6890;

        --font-display: 'Playfair Display', Georgia, serif;
        --font-body:    'Nunito', sans-serif;

        --max-w: 860px;
        --gap:   clamp(4rem, 10vw, 8rem);
        --r:     1.25rem;
      }

      html { scroll-behavior: smooth; }

      body {
        background: var(--base);
        color: var(--texto);
        font-family: var(--font-body);
        font-size: clamp(17px, 2vw, 19px);
        font-weight: 400;
        line-height: 1.85;
        -webkit-font-smoothing: antialiased;
      }

      h1, h2, h3 {
        font-family: var(--font-display);
        line-height: 1.2;
        color: var(--roxo-2);
      }

      h1 { font-size: clamp(2.6rem, 7.5vw, 5rem); font-weight: 600; }
      h2 { font-size: clamp(1.9rem, 4.5vw, 2.8rem); font-weight: 500; }
      h3 { font-size: clamp(1.15rem, 2.5vw, 1.4rem); font-weight: 600; }

      a { color: inherit; text-decoration: none; }
      img { max-width: 100%; display: block; }

      .container {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 0 clamp(1.5rem, 6vw, 3rem);
      }

      .section { padding: var(--gap) 0; }

      .section--alt { background: var(--rosado); }

      .section--dark {
        background: var(--roxo-2);
        color: var(--base);
      }

      .section--dark h2,
      .section--dark h3 { color: var(--lavanda); }

      .section--dark p { color: rgba(250,248,252,0.88); }

      .label {
        font-family: var(--font-body);
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.2em;
        text-transform: uppercase;
        color: var(--lilas);
        display: block;
        margin-bottom: 0.85rem;
      }

      .section--dark .label { color: var(--lavanda); }

      .divider {
        width: 3rem;
        height: 2px;
        background: var(--lavanda);
        border-radius: 2px;
        margin: 1.5rem 0;
      }

      .section--dark .divider { background: var(--lilas); }

      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(28px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .fade-up   { animation: fadeUp 0.9s ease both; }
      .fade-up-2 { animation-delay: 0.15s; }
      .fade-up-3 { animation-delay: 0.3s; }
      .fade-up-4 { animation-delay: 0.45s; }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
