---
import Layout from '../../layouts/Layout.astro';

const posts = await Astro.glob('./*.md');
const sorted = posts.sort((a, b) =>
  new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime()
);

const postsAstro = [
  {
    url: '/blog/consulta-em-casa',
    frontmatter: {
      title: 'O que acontece em uma consulta veterinária em casa',
      categoria: 'Saúde Geral',
      resumo: 'Do primeiro contato ao acompanhamento — como funciona o atendimento domiciliar e por que faz diferença para o animal e para a família.',
      date: '2026-04-18',
    }
  }
];

const todos = [...postsAstro, ...sorted];
---
<Layout title="Blog — Em Casa Vet" description="Artigos sobre saúde e bem-estar animal, geriatria veterinária e cuidados paliativos domiciliários.">

  <nav>
    <div class="container nav-inner">
      <a href="/" class="nav-logo">Em Casa Vet</a>
      <a href="https://wa.me/5543988577434?text=Olá%2C%20Dra.%20Vanessa.%20Gostaria%20de%20entender%20como%20funciona%20o%20atendimento%20e%20saber%20os%20valores." class="btn-nav" target="_blank" rel="noopener">Falar com a Vanessa</a>
    </div>
  </nav>

  <section class="blog-hero">
    <div class="container">
      <span class="label label--secao">Blog</span>
      <h1>Cuidar começa<br /><em>pela informação.</em></h1>
      <p class="blog-hero-sub">Artigos sobre saúde, bem-estar e qualidade de vida para os membros animais da família.</p>
    </div>
  </section>

  <section class="section">