---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const posts = await Astro.glob('./*.md');
  return posts.map((post) => ({
    params: { slug: post.url?.split('/').pop() },
    props: { post },
  }));
}

const { post } = Astro.props;
const { title, date, categoria, resumo } = post.frontmatter;
const { Content } = post;
const WA = 'https://wa.me/5543988577434?text=Olá%2C%20vim%20pelo%20blog%20e%20gostaria%20de%20agendar%20uma%20consulta.';
---
<Layout title={`${title} — Em Casa Vet`} description={resumo}>

  <nav>
    <div class="container nav-inner">
      <a href="/" class="nav-logo">Em Casa Vet</a>
      <a href={WA} class="btn-nav" target="_blank" rel="noopener">Agendar consulta</a>
    </div>
  </nav>

  <article>
    <header class="post-header">
      <div class="container">
        <a href="/blog" class="voltar">← Todos os artigos</a>
        <span class="post-categoria">{categoria}</span>
        <h1>{title}</h1>
        <p class="post-data">
          {new Date(date).toLocaleDateString('pt-BR', { day: '2-digit', month: 'long', year: 'numeric' })}
        </p>
      </div>
    </header>

    <div class="container post-corpo">
      <Content />
    </div>

    <div class="container post-cta">
      <p>Ficou com dúvidas? A Vanessa atende em Londrina, Cambé e Ibiporã.</p>
      <a href={WA} class="btn-primary" target="_blank" rel="noopener">
        Falar com a Vanessa
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.428a.5.5 0 0 0 .609.61l5.71-1.494A11.954 11.954 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.956 9.956 0 0 1-5.127-1.417l-.367-.216-3.808.997 1.013-3.7-.239-.381A9.953 9.953 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
      </a>
    </div>
  </article>

  <footer>
    <div class="container footer-inner">
      <div class="footer-marca">
        <strong>Em Casa Vet</strong>
        <span>Atendimento Veterinário Domiciliar</span>
        <span>CRMV/PR 16455</span>
      </div>
      <div class="footer-links">
        <a href="/">Início</a>
        <a href="/blog">Blog</a>
        <a href="/#vanessa">A veterinária</a>
      </div>
      <div class="footer-extra">
        <span>Londrina · Cambé · Ibiporã</span>
        <a href="https://vanessaokamura.com.br" target="_blank" rel="noopener">
          Autodeclaração e trilha de evidências: vanessaokamura.com.br
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        © 2026 Em Casa Vet — Vanessa Okamura · CRMV/PR 16455
      </div>
    </div>
  </footer>

</Layout>

<style>
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--lavanda-2);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }
  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--texto);
  }
  .btn-nav {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--lilas-2);
    border: 2px solid var(--lavanda-3);
    padding: 0.55rem 1.35rem;
    border-radius: 2rem;
    transition: background 0.2s, color 0.2s;
  }
  .btn-nav:hover {
    background: var(--lilas-2);
    color: #fff;
    border-color: var(--lilas-2);
  }

  .post-header {
    padding: clamp(3.5rem, 9vw, 7rem) 0 clamp(2rem, 5vw, 4rem);
    background: linear-gradient(150deg, var(--lavanda-1) 0%, var(--rosa) 100%);
  }
  .voltar {
    display: inline-block;
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--lilas-2);
    margin-bottom: 1.5rem;
    transition: opacity 0.2s;
  }
  .voltar:hover { opacity: 0.7; }

  .post-categoria {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lilas-2);
    margin-bottom: 0.75rem;
  }
  .post-header h1 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    font-weight: 600;
    color: var(--texto);
    line-height: 1.2;
    max-width: 720px;
    margin-bottom: 1rem;
  }
  .post-data {
    font-size: 0.85rem;
    color: var(--suave);
  }

  .post-corpo {
    padding-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
    max-width: 680px;
  }

  .post-corpo :global(h2) {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 3vw, 1.9rem);
    font-weight: 500;
    color: var(--texto);
    margin: 2.5rem 0 1rem;
  }
  .post-corpo :global(h3) {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.5vw, 1.45rem);
    font-weight: 600;
    color: var(--texto);
    margin: 2rem 0 0.75rem;
  }
  .post-corpo :global(p) {
    color: var(--texto-2);
    margin-bottom: 1.25rem;
    line-height: 1.85;
  }
  .post-corpo :global(ul),
  .post-corpo :global(ol) {
    margin: 1rem 0 1.5rem 1.5rem;
    color: var(--texto-2);
    line-height: 1.85;
  }
  .post-corpo :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-corpo :global(strong) {
    color: var(--texto);
    font-weight: 700;
  }
  .post-corpo :global(blockquote) {
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--texto-2);
    line-height: 1.75;
    padding: 1.25rem 1.75rem;
    margin: 2rem 0;
    background: var(--lavanda-1);
    border-left: 4px solid var(--lavanda-3);
    border-radius: 0 var(--r) var(--r) 0;
  }

  .post-cta {
    padding: 3rem 0 5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    max-width: 680px;
    border-top: 2px solid var(--lavanda-2);
  }
  .post-cta p {
    font-size: 1.05rem;
    color: var(--texto-2);
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background: var(--lilas-2);
    color: #fff;
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 700;
    padding: 1rem 2rem;
    min-height: 56px;
    border-radius: 2rem;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
    box-shadow: 0 4px 18px rgba(139,111,192,0.3);
    width: fit-content;
  }
  .btn-primary:hover {
    background: var(--lilas);
    transform: translateY(-2px);
  }

  footer {
    background: var(--texto);
    color: var(--lavanda-1);
  }
  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }
  .footer-marca { display: flex; flex-direction: column; gap: 0.4rem; }
  .footer-marca strong { font-family: var(--font-display); font-size: 1.25rem; color: var(--lavanda-3); }
  .footer-marca span { font-size: 0.9rem; color: rgba(240,235,250,0.6); }
  .footer-links { display: flex; flex-direction: column; gap: 0.65rem; }
  .footer-links a { font-size: 0.95rem; color: rgba(240,235,250,0.75); transition: color 0.2s; }
  .footer-links a:hover { color: var(--lavanda-3); }
  .footer-extra { display: flex; flex-direction: column; gap: 0.5rem; font-size: 0.95rem; color: rgba(240,235,250,0.6); }
  .footer-extra a { color: var(--lavanda-3); font-size: 0.82rem; line-height: 1.5; transition: opacity 0.2s; }
  .footer-extra a:hover { opacity: 0.75; }
  .footer-bottom { border-top: 1px solid rgba(255,255,255,0.08); padding: 1rem 0; font-size: 0.8rem; color: rgba(240,235,250,0.3); }

  @media (max-width: 680px) {
    .footer-inner { grid-template-columns: 1fr; gap: 2rem; }
    .btn-nav { display: none; }
  }
</style>
