---
import Layout from '../layouts/Layout.astro';

const WA = 'https://wa.me/5543988577434?text=Olá%2C%20vim%20pelo%20site%20e%20gostaria%20de%20agendar%20uma%20consulta.';
const WA_LABEL = 'Falar com a Vanessa';

const servicos = [
  {
    nome: 'Vacinas',
    desc: 'Sem estresse de transporte. No horário que funciona para a família.',
  },
  {
    nome: 'Consulta clínica',
    desc: 'Para o filhote recém-adotado, para o check-up anual, para quando algo mudou e você quer entender o que é.',
  },
  {
    nome: 'Curativos e procedimentos',
    desc: 'Sem precisar sair de casa.',
  },
  {
    nome: 'Coleta de exames de sangue',
    desc: 'Em casa, o resultado reflete o animal — não o estresse do dia.',
  },
  {
    nome: 'Soro em domicílio',
    desc: 'Para animais com doença renal ou que precisam de hidratação regular.',
  },
  {
    nome: 'Geriatria',
    desc: 'Acompanhamento especializado para animais na terceira idade.',
  },
  {
    nome: 'Cuidados paliativos',
    desc: 'Gestão da dor, do conforto e da qualidade de vida — em qualquer fase do tratamento.',
  },
  {
    nome: 'Encaminhamento e acompanhamento',
    desc: 'Quando o caso exige clínica ou hospital, a Vanessa indica lugares de confiança e não sai do caso.',
  },
];
---
<Layout>

  <!-- NAV -->
  <nav>
    <div class="container nav-inner">
      <a href="/" class="nav-logo">Em Casa Vet</a>
      <a href={WA} class="btn-nav" target="_blank" rel="noopener">Agendar consulta</a>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="container">
      <span class="label fade-up">Atendimento veterinário domiciliar</span>
      <h1 class="fade-up fade-up-2">No aconchego<br /><em>do lar.</em></h1>
      <p class="hero-sub fade-up fade-up-3">
        É onde ele é ele mesmo. Onde quem cuida está.<br />
        Onde o cuidado faz mais sentido.
      </p>
      <div class="hero-meta fade-up fade-up-4">
        <span>Londrina · Cambé · Ibiporã</span>
      </div>
      <a href={WA} class="btn-primary fade-up fade-up-4" target="_blank" rel="noopener">
        {WA_LABEL}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.428a.5.5 0 0 0 .609.61l5.71-1.494A11.954 11.954 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.956 9.956 0 0 1-5.127-1.417l-.367-.216-3.808.997 1.013-3.7-.239-.381A9.953 9.953 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
      </a>
    </div>
    <div class="hero-ornament" aria-hidden="true"></div>
  </section>

  <!-- SERVIÇOS -->
  <section class="section section--alt" id="servicos">
    <div class="container">
      <span class="label">O que a Vanessa faz</span>
      <h2>Ela atende em casa.</h2>
      <div class="divider"></div>
      <div class="servicos-grid">
        {servicos.map((s) => (
          <div class="servico-item">
            <h3>{s.nome}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="cta-center">
        <a href={WA} class="btn-primary" target="_blank" rel="noopener">
          {WA_LABEL}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.428a.5.5 0 0 0 .609.61l5.71-1.494A11.954 11.954 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.956 9.956 0 0 1-5.127-1.417l-.367-.216-3.808.997 1.013-3.7-.239-.381A9.953 9.953 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- POR QUE EM CASA -->
  <section class="section" id="porque">
    <div class="container">
      <span class="label">O diferencial</span>
      <h2>Em casa, tudo fica mais claro.</h2>
      <div class="divider"></div>
      <div class="porque-grid">
        <div class="porque-bloco">
          <h3>Quem fala com a veterinária</h3>
          <p>
            Na consulta domiciliar, a Vanessa conversa com quem acorda cedo para ver se ele comeu.
            Com quem notou que ele está bebendo menos água. Com quem sabe que ele manca às vezes —
            mas só quando levanta depois de dormir.
          </p>
          <p>Essas pessoas raramente são as que dirigem até a clínica.</p>
        </div>
        <div class="porque-bloco">
          <h3>Como o animal se apresenta</h3>
          <p>
            Está no sofá dele. No cheiro dele. Sem outros bichos, sem sala de espera.
            Sendo ele mesmo — do jeito que a veterinária precisa ver para entender o que está acontecendo.
          </p>
          <p>
            A Vanessa também vê onde ele dorme, o que come, se passa calor ou frio,
            como se movimenta no próprio espaço. Informações que a clínica nunca vai ter.
          </p>
        </div>
        <div class="porque-bloco porque-destaque">
          <h3>Nos exames de sangue — especialmente em gatos</h3>
          <p>
            O estresse do transporte eleva o cortisol e pode distorcer os resultados.
            Em casa, o exame reflete o animal — não o dia difícil que ele teve.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- GERIATRIA -->
  <section class="section section--alt" id="geriatria">
    <div class="container">
      <span class="label">Geriatria veterinária</span>
      <h2>Envelhecer bem também<br />é um objetivo de saúde.</h2>
      <div class="divider"></div>
      <div class="texto-bloco">
        <p>
          Alguns animais chegam para a Vanessa ainda filhotes e envelhecem com ela como veterinária
          de referência. Outros chegam já na terceira idade — companheiros de vida de tutores que
          também envelheceram juntos, ou herdados de pais que partiram.
        </p>
        <p>
          Esses animais precisam de um olhar diferente. A dor nas juntas que mudou o jeito de subir
          no sofá. O frio que sente mais. A ração que precisa mudar. A desorientação que parece
          demência. A rotina da casa que pode ser ajustada para ele viver melhor.
        </p>
        <p>
          A Vanessa vê tudo isso no ambiente onde acontece. O objetivo não é curar o envelhecimento —
          é que essa fase seja vivida com conforto, presença e qualidade.
        </p>
      </div>
    </div>
  </section>

  <!-- PALIATIVOS -->
  <section class="section section--dark" id="paliativos">
    <div class="container">
      <span class="label">Cuidados paliativos</span>
      <h2>Qualidade de vida —<br />em qualquer fase do tratamento.</h2>
      <div class="divider"></div>
      <div class="texto-bloco">
        <p>
          O cuidado paliativo não começa quando a cura deixa de ser possível. Ele começa quando
          o bem-estar do animal precisa ser protegido ativamente — seja durante um tratamento, seja depois.
        </p>
        <p>
          Muitos pacientes chegam após um diagnóstico de câncer, após um longo caminho oncológico.
          Outros têm doenças crônicas como insuficiência renal, que exigem cuidados contínuos no dia a dia.
        </p>
        <p>
          Gestão da dor, ajuste alimentar, controle térmico, soro em casa, medicação para quem o
          responsável não consegue administrar sozinho. A Vanessa organiza o cuidado no ambiente onde
          o animal já está — e orienta a família para que o dia a dia faça sentido.
        </p>
      </div>
    </div>
  </section>

  <!-- VANESSA -->
  <section class="section" id="vanessa">
    <div class="container">
      <span class="label">Quem é a Vanessa</span>
      <h2>Formação para cuidar<br />em qualquer fase.</h2>
      <div class="divider"></div>
      <div class="vanessa-grid">
        <div class="texto-bloco">
          <p>
            Vanessa Okamura é médica veterinária com mestrado em Clínicas Veterinárias pela UEL —
            com dissertação pioneira no Paraná sobre medicina veterinária baseada em evidências no
            atendimento domiciliar.
          </p>
          <p>
            Tem especialização em Cuidados Paliativos e Terapia da Dor pela PUC Minas (384h)
            e registro ativo no CRMV/PR 16455.
          </p>
          <p>Atende em Londrina, Cambé e Ibiporã.</p>
        </div>
        <div class="credenciais">
          <div class="credencial-item">
            <span class="credencial-label">Mestrado</span>
            <span>Clínicas Veterinárias — UEL</span>
          </div>
          <div class="credencial-item">
            <span class="credencial-label">Especialização</span>
            <span>Cuidados Paliativos e Terapia da Dor — PUC Minas</span>
          </div>
          <div class="credencial-item">
            <span class="credencial-label">Registro</span>
            <span>CRMV/PR 16455 — ativo</span>
          </div>
          <div class="credencial-item">
            <span class="credencial-label">Cobertura</span>
            <span>Londrina · Cambé · Ibiporã</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA FINAL -->
  <section class="section cta-final">
    <div class="container cta-final-inner">
      <h2>Seu animal merece<br /><em>cuidado em casa.</em></h2>
      <p>A primeira conversa é pelo WhatsApp. Sem compromisso.</p>
      <a href={WA} class="btn-primary btn-large" target="_blank" rel="noopener">
        {WA_LABEL}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.428a.5.5 0 0 0 .609.61l5.71-1.494A11.954 11.954 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.956 9.956 0 0 1-5.127-1.417l-.367-.216-3.808.997 1.013-3.7-.239-.381A9.953 9.953 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
      </a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="container footer-inner">
      <div class="footer-marca">
        <strong>Em Casa Vet</strong>
        <span>Atendimento Veterinário Domiciliar</span>
        <span>CRMV/PR 16455</span>
      </div>
      <div class="footer-links">
        <a href="#servicos">Serviços</a>
        <a href="#porque">Por que em casa</a>
        <a href="#geriatria">Geriatria</a>
        <a href="#paliativos">Paliativos</a>
        <a href="#vanessa">A veterinária</a>
      </div>
      <div class="footer-extra">
        <span>Londrina · Cambé · Ibiporã</span>
        <a href="https://vanessaokamura.com.br" target="_blank" rel="noopener">vanessaokamura.com.br</a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        © 2026 Em Casa Vet — Vanessa Okamura · CRMV/PR 16455
      </div>
    </div>
  </footer>

</Layout>

<style>
  /* NAV */
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(250, 247, 242, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--areia-2);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    padding-bottom: 1rem;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--musgo-2);
    letter-spacing: 0.02em;
  }

  .btn-nav {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    color: var(--musgo-2);
    border: 1px solid var(--musgo);
    padding: 0.45rem 1rem;
    border-radius: 2rem;
    transition: background 0.2s, color 0.2s;
  }

  .btn-nav:hover {
    background: var(--musgo-2);
    color: var(--areia);
  }

  /* HERO */
  .hero {
    position: relative;
    padding: clamp(4rem, 12vw, 8rem) 0 clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  .hero h1 {
    margin: 0.5rem 0 1.5rem;
    color: var(--escuro);
  }

  .hero h1 em {
    font-style: italic;
    color: var(--musgo);
  }

  .hero-sub {
    font-size: clamp(1rem, 2.5vw, 1.2rem);
    color: var(--medio);
    max-width: 480px;
    margin-bottom: 1.5rem;
    line-height: 1.6;
  }

  .hero-meta {
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--claro);
    margin-bottom: 2rem;
  }

  .hero-ornament {
    position: absolute;
    right: -8vw;
    top: 50%;
    transform: translateY(-50%);
    width: clamp(200px, 38vw, 480px);
    height: clamp(200px, 38vw, 480px);
    border-radius: 50%;
    background: radial-gradient(circle, var(--areia-2) 0%, transparent 70%);
    opacity: 0.6;
    pointer-events: none;
  }

  /* BOTÕES */
  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--musgo-2);
    color: var(--areia);
    font-size: 0.88rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    padding: 0.85rem 1.75rem;
    border-radius: 2rem;
    transition: background 0.2s, transform 0.15s;
  }

  .btn-primary:hover {
    background: var(--musgo);
    transform: translateY(-1px);
  }

  .btn-large {
    font-size: 1rem;
    padding: 1rem 2.25rem;
  }

  .cta-center {
    margin-top: 2.5rem;
  }

  /* SERVIÇOS */
  .servicos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }

  .servico-item {
    background: var(--creme);
    border: 1px solid var(--areia-2);
    border-radius: 0.75rem;
    padding: 1.5rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }

  .servico-item:hover {
    box-shadow: 0 4px 20px rgba(90,110,74,0.1);
    transform: translateY(-2px);
  }

  .servico-item h3 {
    font-size: 1rem;
    margin-bottom: 0.5rem;
    color: var(--musgo-2);
  }

  .servico-item p {
    font-size: 0.9rem;
    color: var(--medio);
    line-height: 1.6;
  }

  /* POR QUE */
  .porque-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }

  .porque-bloco {
    padding: 1.75rem;
    border-left: 2px solid var(--areia-2);
  }

  .porque-bloco h3 {
    font-size: 1rem;
    color: var(--musgo-2);
    margin-bottom: 0.75rem;
  }

  .porque-bloco p {
    color: var(--medio);
    font-size: 0.95rem;
    margin-bottom: 0.75rem;
  }

  .porque-destaque {
    grid-column: 1 / -1;
    background: var(--areia);
    border: none;
    border-radius: 0.75rem;
    padding: 1.75rem 2rem;
    border-left: 3px solid var(--musgo);
  }

  /* TEXTOS */
  .texto-bloco p {
    margin-bottom: 1rem;
    color: var(--medio);
    max-width: 660px;
  }

  .section--dark .texto-bloco p {
    color: rgba(245,240,232,0.82);
  }

  /* VANESSA */
  .vanessa-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 2rem;
    align-items: start;
  }

  .credenciais {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .credencial-item {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--areia-2);
    font-size: 0.9rem;
    color: var(--medio);
  }

  .credencial-label {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--musgo);
    font-weight: 500;
  }

  /* CTA FINAL */
  .cta-final {
    background: var(--areia-2);
    text-align: center;
  }

  .cta-final-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.25rem;
  }

  .cta-final h2 em {
    font-style: italic;
    color: var(--musgo);
  }

  .cta-final p {
    color: var(--claro);
    font-size: 0.95rem;
  }

  /* FOOTER */
  footer {
    background: var(--escuro);
    color: var(--areia);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1fr;
    gap: 2rem;
    padding-top: 3rem;
    padding-bottom: 3rem;
  }

  .footer-marca {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .footer-marca strong {
    font-family: var(--font-display);
    font-size: 1.15rem;
    color: var(--terra);
  }

  .footer-marca span {
    font-size: 0.85rem;
    color: rgba(245,240,232,0.6);
  }

  .footer-links {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .footer-links a {
    font-size: 0.85rem;
    color: rgba(245,240,232,0.7);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--terra);
  }

  .footer-extra {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(245,240,232,0.6);
  }

  .footer-extra a {
    color: var(--terra);
    transition: opacity 0.2s;
  }

  .footer-extra a:hover { opacity: 0.75; }

  .footer-bottom {
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 1rem 0;
    font-size: 0.75rem;
    color: rgba(245,240,232,0.35);
  }

  /* RESPONSIVO */
  @media (max-width: 680px) {
    .porque-grid,
    .vanessa-grid {
      grid-template-columns: 1fr;
    }

    .footer-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .porque-destaque {
      grid-column: 1;
    }

    .btn-nav {
      display: none;
    }
  }
</style>
