---
import Layout from '../layouts/Layout.astro';

const WA = 'https://wa.me/5543988577434?text=Olá%2C%20vim%20pelo%20site%20e%20gostaria%20de%20agendar%20uma%20consulta.';
const WA_LABEL = 'Falar com a Vanessa';

const posts = await Astro.glob('./blog/*.md');
const recentes = posts
  .sort((a, b) => new Date(b.frontmatter.date).getTime() - new Date(a.frontmatter.date).getTime())
  .slice(0, 3);

const servicos = [
  {
    nome: 'Consulta clínica',
    desc: 'Para o filhote recém-adotado, para o check-up anual, para quando algo mudou e você quer entender o que é.',
    citacao: 'Hoje a família cresceu. É um momento lindo — e também é o momento de entender o que esse novo membro precisa para chegar bem na casa dele. Vamos conversar sobre isso juntos.',
  },
  {
    nome: 'Vacinas',
    desc: 'Sem estresse de transporte. No horário que funciona para a família.',
    imagem: '/imagens/vacinas.webp',
    imagemAlt: 'Gato tranquilo sendo vacinado em casa',
  },
  {
    nome: 'Coleta de exames de sangue',
    desc: 'Em casa, o resultado reflete o animal — não o estresse do dia.',
  },
  {
    nome: 'Soro em domicílio',
    desc: 'Para animais com doença renal ou que precisam de hidratação regular.',
  },
  {
    nome: 'Acompanhamento pré e pós-cirúrgico',
    desc: 'Quando o animal precisa de cirurgia, preparo antes e acompanho a recuperação em casa — do preparo até o retorno pleno.',
  },
  {
    nome: 'Geriatria',
    desc: 'Acompanhamento especializado para animais na terceira idade.',
  },
  {
    nome: 'Cuidados paliativos',
    desc: 'Gestão da dor, do conforto e da qualidade de vida — em qualquer fase do tratamento.',
  },
  {
    nome: 'Encaminhamento e acompanhamento',
    desc: 'Quando o caso exige clínica ou hospital, indico lugares de confiança e não saio do caso.',
  },
];
---
<Layout>

  <!-- NAV -->
  <nav>
    <div class="container nav-inner">
      <a href="/" class="nav-logo">Em Casa Vet</a>
      <div class="nav-links">
        <a href="/blog" class="nav-link">Blog</a>
        <a href={WA} class="btn-nav-wa" target="_blank" rel="noopener">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.428a.5.5 0 0 0 .609.61l5.71-1.494A11.954 11.954 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.956 9.956 0 0 1-5.127-1.417l-.367-.216-3.808.997 1.013-3.7-.239-.381A9.953 9.953 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
          <span class="wa-label">Falar com a Vanessa</span>
        </a>
      </div>
    </div>
  </nav>

  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="container hero-inner">
      <div class="hero-texto">
        <span class="label--hero fade-up">Atendimento domiciliar</span>
        <h1 class="fade-up fade-up-2">No aconchego<br />do lar.</h1>
        <p class="hero-sub fade-up fade-up-3">
          É onde ele é ele mesmo. Onde quem cuida está.<br />
          Onde o cuidado faz mais sentido.
        </p>
        <p class="hero-meta fade-up fade-up-3">Londrina · Cambé · Ibiporã</p>
        <blockquote class="citacao fade-up fade-up-4">
          "Quando chego na casa, já consigo ver coisas que nenhum exame mostra. Onde ele dorme, o potinho de água, como ele me recebe. Isso faz parte da consulta."
          <cite>— Vanessa Okamura</cite>
        </blockquote>
        <div class="hero-btns fade-up fade-up-4">
          <a href="/blog" class="btn-blog">Ler artigos →</a>
          <a href={WA} class="btn-primary" target="_blank" rel="noopener">
            {WA_LABEL}
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.428a.5.5 0 0 0 .609.61l5.71-1.494A11.954 11.954 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.956 9.956 0 0 1-5.127-1.417l-.367-.216-3.808.997 1.013-3.7-.239-.381A9.953 9.953 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
          </a>
        </div>
      </div>
      <div class="hero-imagem">
        <img src="/imagens/hero.webp" alt="Veterinária atendendo cachorro em casa com tutor relaxado" loading="eager" />
      </div>
    </div>
  </section>

  <!-- SERVIÇOS -->
  <section class="section section--alt" id="servicos">
    <div class="container">
      <span class="label label--secao">O que faço</span>
      <h2>Atendo em casa.</h2>
      <div class="divider"></div>
      <ul class="servicos-lista">
        {servicos.map((s) => (
          <li class="servico-linha">
            <span class="servico-nome">{s.nome}</span>
            <span class="servico-desc">{s.desc}</span>
            {s.imagem && (
              <img class="servico-img" src={s.imagem} alt={s.imagemAlt} loading="lazy" />
            )}
            {s.citacao && (
              <blockquote class="citacao citacao--servico">
                "{s.citacao}"
                <cite>— Vanessa Okamura</cite>
              </blockquote>
            )}
          </li>
        ))}
      </ul>
      <div class="cta-center">
        <a href={WA} class="btn-primary" target="_blank" rel="noopener">
          {WA_LABEL}
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.428a.5.5 0 0 0 .609.61l5.71-1.494A11.954 11.954 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.956 9.956 0 0 1-5.127-1.417l-.367-.216-3.808.997 1.013-3.7-.239-.381A9.953 9.953 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- POR QUE EM CASA -->
  <section class="section" id="porque">
    <div class="container">
      <span class="label label--secao">O diferencial</span>
      <h2>Em casa, tudo fica mais claro.</h2>
      <div class="divider"></div>
      <div class="porque-layout">
        <div class="blocos-stack">
          <div class="bloco-card">
            <h3>Quem fala comigo</h3>
            <p>
              Na consulta domiciliar, converso com quem acorda cedo para ver se ele comeu.
              Com quem notou que ele está bebendo menos água. Com quem sabe que ele manca às vezes —
              mas só quando levanta depois de dormir.
            </p>
            <p>Essa pessoa raramente é a que dirige até a clínica.</p>
          </div>
          <div class="bloco-card">
            <h3>Como o animal se apresenta</h3>
            <p>
              Está no sofá dele. No cheiro dele. Sem outros bichos, sem sala de espera.
              Sendo ele mesmo — do jeito que preciso ver para entender o que está acontecendo.
            </p>
            <p>
              Também consigo ver onde ele dorme, o que come, se passa calor ou frio,
              como se movimenta no próprio espaço. Informações que a clínica nunca vai ter.
            </p>
          </div>
          <div class="bloco-card bloco-destaque">
            <h3>Nos exames de sangue — especialmente em gatos</h3>
            <p>
              O estresse do transporte eleva o cortisol e pode distorcer os resultados.
              Em casa, o exame reflete o animal — não o dia difícil que ele teve.
            </p>
          </div>
        </div>
        <div class="porque-imagem">
          <img src="/imagens/porque-em-casa.webp" alt="Veterinária observando gato no próprio ambiente doméstico" loading="lazy" />
        </div>
      </div>
      <blockquote class="citacao citacao--alt">
        "Para mim, o pet é um membro da família. Não uso a palavra dono — uso tutor. Porque ele não pertence a ninguém. Ele escolheu estar com vocês."
        <cite>— Vanessa Okamura</cite>
      </blockquote>
    </div>
  </section>

  <!-- GERIATRIA -->
  <section class="section section--alt" id="geriatria">
    <div class="container">
      <span class="label label--secao">Geriatria veterinária</span>
      <h2>Envelhecer bem também<br />é um objetivo de saúde.</h2>
      <div class="divider"></div>
      <div class="secao-com-imagem">
        <div class="texto-bloco">
          <p>
            Alguns animais chegam para mim ainda filhotes e envelhecem comigo como veterinária
            de referência. Outros chegam já na terceira idade — companheiros de vida de tutores que
            também envelheceram juntos, ou herdados de pais que partiram.
          </p>
          <p>
            Esses animais precisam de um olhar diferente. A dor nas juntas que mudou o jeito de subir
            no sofá. O frio que sentem mais. A ração que precisa mudar. A desorientação que parece
            demência. A rotina da casa que pode ser ajustada para ele viver melhor.
          </p>
          <p>
            Vejo tudo isso no ambiente onde acontece. O objetivo não é curar o envelhecimento —
            é que essa fase seja vivida com conforto, presença e qualidade.
          </p>
          <blockquote class="citacao citacao--alt">
            "O que ele mais quer é simples: que vocês estejam bem. Ele não liga para mais nada além de estar com a família dele, com as pessoas que ele ama. Quando a gente cuida dele, está cuidando dessa troca."
            <cite>— Vanessa Okamura</cite>
          </blockquote>
        </div>
        <div class="secao-imagem">
          <img src="/imagens/geriatria.webp" alt="Veterinária orientando tutor idoso sobre medicação do cachorro em casa" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- PALIATIVOS -->
  <section class="section section--dark" id="paliativos">
    <div class="container">
      <span class="label">Cuidados paliativos</span>
      <h2>Qualidade de vida —<br />em qualquer fase do tratamento.</h2>
      <div class="divider"></div>
      <div class="secao-com-imagem secao-com-imagem--invertida">
        <div class="texto-bloco">
          <p>
            O cuidado paliativo não começa quando a cura deixa de ser possível. Ele começa quando
            o bem-estar do animal precisa ser protegido ativamente — seja durante um tratamento, seja depois.
          </p>
          <p>
            Muitos pacientes chegam após um diagnóstico de câncer, após um longo caminho oncológico.
            Outros têm doenças crônicas como insuficiência renal, que exigem cuidados contínuos no dia a dia.
          </p>
          <p>
            Gestão da dor, ajuste alimentar, controle térmico, soro em casa, medicação para quem o
            responsável não consegue administrar sozinho. Organizo o cuidado no ambiente onde
            o animal já está — e oriento a família para que o dia a dia faça sentido.
          </p>
          <blockquote class="citacao citacao--alt">
            "Ele merece o mesmo cuidado que qualquer membro da família mereceria. Sem culpa, sem julgamento. Com presença."
            <cite>— Vanessa Okamura</cite>
          </blockquote>
        </div>
        <div class="secao-imagem">
          <img src="/imagens/paliativos.webp" alt="Veterinária ausculando cachorro tranquilo no sofá com tutor idoso presente" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <!-- VANESSA -->
  <section class="section" id="vanessa">
    <div class="container">
      <span class="label label--secao">Quem sou eu</span>
      <h2>Formação para cuidar<br />em qualquer fase.</h2>
      <div class="divider"></div>
      <div class="vanessa-layout">
        <div class="vanessa-imagem">
          <img src="/imagens/vanessa.webp" alt="Veterinária e tutora cuidando de golden retriever juntas em casa" loading="lazy" />
        </div>
        <div class="vanessa-conteudo">
          <div class="texto-bloco">
            <p>
              Sou médica veterinária com mestrado em Clínicas Veterinárias pela UEL —
              com dissertação pioneira no Paraná sobre medicina veterinária baseada em evidências no
              atendimento domiciliar.
            </p>
            <p>
              Tenho especialização em Cuidados Paliativos e Terapia da Dor pela PUC Minas (384h)
              e registro ativo no CRMV/PR 16455.
            </p>
            <p>Atendo em Londrina, Cambé e Ibiporã.</p>
          </div>
          <div class="credenciais">
            <div class="credencial-item">
              <span class="credencial-label">Mestrado</span>
              <span>Clínicas Veterinárias — UEL</span>
            </div>
            <div class="credencial-item">
              <span class="credencial-label">Especialização</span>
              <span>Cuidados Paliativos e Terapia da Dor — PUC Minas</span>
            </div>
            <div class="credencial-item">
              <span class="credencial-label">Registro</span>
              <span>CRMV/PR 16455 — ativo</span>
            </div>
            <div class="credencial-item">
              <span class="credencial-label">Cobertura</span>
              <span>Londrina · Cambé · Ibiporã</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- DO BLOG -->
  {recentes.length > 0 && (
    <section class="section section--alt" id="blog">
      <div class="container">
        <span class="label label--secao">Do blog</span>
        <h2>Cuidar começa pela informação.</h2>
        <p class="blog-intro">Artigos sobre saúde, bem-estar e qualidade de vida para os membros animais da família.</p>
        <div class="divider"></div>
        <ul class="blog-recentes">
          {recentes.map((post) => (
            <li class="blog-card">
              <a href={post.url}>
                <span class="blog-card-categoria">{post.frontmatter.categoria}</span>
                <h3 class="blog-card-titulo">{post.frontmatter.title}</h3>
                <p class="blog-card-resumo">{post.frontmatter.resumo}</p>
                <span class="blog-card-link">Ler artigo →</span>
              </a>
            </li>
          ))}
        </ul>
        <div class="cta-center">
          <a href="/blog" class="btn-blog">Ver todos os artigos</a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA FINAL -->
  <section class="section cta-final">
    <div class="container cta-final-inner">
      <img src="/imagens/cta.webp" alt="Agende sua consulta veterinária domiciliar" class="cta-imagem" loading="lazy" />
      <h2>Seu animal merece<br />cuidado em casa.</h2>
      <p class="cta-sub">
        A primeira conversa é pelo WhatsApp.<br />
        <span class="cta-sub-destaque">Sem compromisso.</span>
      </p>
      <a href={WA} class="btn-primary btn-large" target="_blank" rel="noopener">
        {WA_LABEL}
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.127.558 4.126 1.535 5.858L.057 23.428a.5.5 0 0 0 .609.61l5.71-1.494A11.954 11.954 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 22a9.956 9.956 0 0 1-5.127-1.417l-.367-.216-3.808.997 1.013-3.7-.239-.381A9.953 9.953 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10z"/></svg>
      </a>
    </div>
  </section>

  <!-- FOOTER -->
  <footer>
    <div class="container footer-inner">
      <div class="footer-marca">
        <strong>Em Casa Vet</strong>
        <span>Atendimento Veterinário Domiciliar</span>
        <span>CRMV/PR 16455</span>
      </div>
      <div class="footer-links">
        <a href="/blog">Blog</a>
        <a href="#servicos">Serviços</a>
        <a href="#porque">Por que em casa</a>
        <a href="#geriatria">Geriatria</a>
        <a href="#paliativos">Paliativos</a>
        <a href="#vanessa">A veterinária</a>
      </div>
      <div class="footer-extra">
        <span>Londrina · Cambé · Ibiporã</span>
        <a href="https://vanessaokamura.com.br" target="_blank" rel="noopener">
          Autodeclaração e trilha de evidências: vanessaokamura.com.br
        </a>
      </div>
    </div>
    <div class="footer-bottom">
      <div class="container">
        © 2026 Em Casa Vet — Vanessa Okamura · CRMV/PR 16455
      </div>
    </div>
  </footer>

</Layout>

<style>
  /* NAV */
  nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,255,255,0.95);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--lavanda-2);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    padding-bottom: 0.85rem;
  }

  .nav-logo {
    font-family: var(--font-display);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--texto);
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav-link {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--texto-2);
    transition: color 0.2s;
  }

  .nav-link:hover { color: var(--lilas-2); }

  .btn-nav-wa {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #25D366;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    padding: 0.55rem 1.1rem;
    border-radius: 2rem;
    transition: background 0.2s, transform 0.15s;
    box-shadow: 0 2px 10px rgba(37,211,102,0.3);
  }

  .btn-nav-wa:hover {
    background: #1da851;
    transform: translateY(-1px);
  }

  /* HERO */
  .hero {
    position: relative;
    padding: clamp(4rem, 10vw, 8rem) 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 65% 75% at 95% 40%, var(--lavanda-2) 0%, transparent 65%),
      radial-gradient(ellipse 40% 50% at 5% 90%, var(--rosa) 0%, transparent 60%);
    pointer-events: none;
  }

  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    position: relative;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 600;
    color: var(--texto);
    margin: 0.5rem 0 1.25rem;
  }

  .hero-sub {
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    color: var(--texto-2);
    max-width: 480px;
    margin-bottom: 0.75rem;
    line-height: 1.75;
  }

  .hero-meta {
    font-size: 0.85rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--suave);
