</a>

<style>
  .wa-float {
    position: fixed;
    bottom: 24px;
    right: 24px;
    bottom: max(24px, env(safe-area-inset-bottom, 24px));
    z-index: 50;
    width: 56px;
    height: 56px;
    background: #25D366;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.18);
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.3s ease, transform 0.3s ease, box-shadow 0.2s ease, scale 0.2s ease;
  }

  .wa-float.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .wa-float:hover {
    box-shadow: 0 6px 24px rgba(0, 0, 0, 0.25);
    scale: 1.05;
  }

  @media (min-width: 768px) {
    .wa-float {
      width: 64px;
      height: 64px;
    }

    .wa-float svg {
      width: 32px;
      height: 32px;
    }
  }
</style>

<script>
  const btn = document.querySelector('.wa-float');
  setTimeout(() => {
    btn?.classList.add('visible');
  }, 1500);
</script>
